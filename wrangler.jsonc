{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics",
  "account_id": "6781463cd862c4c93076626a02f1aa18",
  "workers_dev": true,
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; the dashboard and /js/script.js are served as free static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      "database_id": "25347fe6-d75a-41ed-a395-711e6d34fc71",
      "migrations_dir": "migrations"
    }
  ]
}
